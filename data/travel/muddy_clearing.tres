[sub_resource type="Resource" id="Resource_tjpsu"]
script = ExtResource("1_p4lnq")
button_text = "Follow path"
opt_effects = Array[int]([])
opt_text = "After a few hours, you reach a village, or rather what remains of it. The villagers are grateful that you have come, but very concerned that they will not survive the night."
opt_difficultiy_change = 1
opt_location_keywords = Array[int]([3])
metadata/_custom_type_script = "uid://ddoi7l4te1l2a"

[sub_resource type="Resource" id="Resource_aesnb"]
script = ExtResource("1_p4lnq")
button_text = "Fight through undergrowth"
opt_effects = Array[int]([])
opt_text = "You struggle through the thicket for several hours. When you stumble out of the forest in the late afternoon, you find yourselves in a small village. Hurry, it will be dark very soon."
opt_difficultiy_change = 0
opt_location_keywords = Array[int]([1])
metadata/_custom_type_script = "uid://ddoi7l4te1l2a"

[resource]
script = ExtResource("2_imopb")
text = "You step into a muddy clearing, sunlight on your face, but smoke clouds darken the horizon. Tracks lead east—the shortest route, straight toward the smoke. There are no other paths; you’d have to force your way through the undergrowth to avoid it."
choices = Array[ExtResource("1_p4lnq")]([SubResource("Resource_tjpsu"), SubResource("Resource_aesnb")])
metadata/_custom_type_script = "uid://dl34a76dc7a6c"
