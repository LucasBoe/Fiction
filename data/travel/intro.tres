resource_local_to_scene = true
script = ExtResource("1_wdyy5")
button_text = "Ready!"
cost = 0
feedback_text = "Use your [color=orange]Wagons[/color] to defend the village and their [color=orange]Houses[/color]. They will reward you for even the smallest hut that you save.

The [color=orange]Smith[/color] might still have time to upgrade you wagons and the [color=orange]Wagon Maker[/color] can build you new wagons for the harsh journey ahead. 

But most importantly make sure your [color=orange]King's Wagon[/color] is not getting destroyed. "
