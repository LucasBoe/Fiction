; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[application]

config/name="New Game Project"
run/main_scene="uid://ela3ol1lqpt7"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

EntityHandler="*res://scripts/autoload/entity_handler.gd"
HealthBarCanvas="*res://scenes/ui/health_bar_canvas.gd"
Globals="*res://scripts/autoload/globals.gd"
MoneyHandler="*res://scripts/autoload/money_handler.gd"
NarrativeCanvas="*res://scenes/autoload/narrative_canvas.tscn"
RaycastHandler="*res://scenes/autoload/raycast_handler.tscn"
RewardHandler="*res://scenes/autoload/reward_handler.tscn"
TooltipHandler="*res://scenes/autoload/tooltip_handler.tscn"
DefeatHandler="*res://scenes/autoload/defeat_handler.tscn"
GridVisualizer="*res://scenes/autoload/grid_visualizer.tscn"
MusicPlayer="*res://scenes/autoload/music_player.tscn"
FadeEffectCanvas="*res://scenes/autoload/fade_effect_canvas.tscn"
SoundPlayer="*res://scenes/autoload/sound_player.tscn"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=920
window/size/viewport_height=640
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="uid://bjos0os13v61q"
theme/custom_font="uid://pbrmctq7sdlw"

