[resource]
script = ExtResource("2_wx4ia")
type = 2
choices = Array[ExtResource("1_wdyy5")]([SubResource("Resource_tjpsu")])
text = "...Dark forces are attacking your kingdom.
You as the [color=orange]King[/color] have only one choice - [color=orange]escape to the capital city of Midas Trith.[/color] Pack everything in your Wagons and travel fast. 
But beware, you have to [color=orange]find a safe place for the night[/color] when the \"Morphed\" creep up from their holes and caves to rampage the land. 

Are you ready to defend your people? "
metadata/_custom_type_script = "uid://dl34a76dc7a6c"
